<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a2a4a">

    <!-- CERCLE GRAND EN HAUT A DROITE -->
    <View
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:background="@drawable/shape_cercle_deco"
        android:layout_gravity="top|end"
        android:translationX="80dp"
        android:translationY="-80dp"
        android:alpha="0.4"/>

    <!-- CERCLE PETIT EN HAUT A DROITE -->
    <View
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:background="@drawable/shape_cercle_deco"
        android:layout_gravity="top|end"
        android:translationX="30dp"
        android:translationY="60dp"
        android:alpha="0.3"/>

    <!-- CERCLE EN BAS A GAUCHE -->
    <View
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:background="@drawable/shape_cercle_deco"
        android:layout_gravity="bottom|start"
        android:translationX="-60dp"
        android:translationY="60dp"
        android:alpha="0.2"/>

    <!-- CONTENU PRINCIPAL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <!-- LOGO -->
        <FrameLayout
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:background="@drawable/shape_logo">

            <ImageView
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:src="@drawable/baseline_search_24"
                android:layout_gravity="center"/>

        </FrameLayout>

        <!-- NOM APP -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Job"
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Match"
                android:textColor="#4a90d9"
                android:textSize="36sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ANALYZER"
            android:textColor="#B0BEC5"
            android:textSize="13sp"
            android:letterSpacing="0.3"
            android:layout_marginTop="6dp"/>

        <!-- POINTS DE NAVIGATION -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="32dp"
            android:gravity="center_vertical">

            <View
                android:layout_width="24dp"
                android:layout_height="8dp"
                android:background="#4a90d9"
                android:layout_marginEnd="8dp"/>

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="#B0BEC5"
                android:layout_marginEnd="8dp"/>

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="#B0BEC5"/>

        </LinearLayout>

        <!-- BOUTONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:layout_marginTop="60dp">

            <!-- BOUTON S'INSCRIRE -->
            <LinearLayout
                android:id="@+id/buttonSinscrire"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/shape_button_blue"
                android:layout_marginBottom="15dp"
                android:paddingStart="34dp"
                >

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="S'inscrire"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:text="›"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:gravity="center"
                    android:background="@drawable/shape_button_arrow"/>

            </LinearLayout>

            <!-- BOUTON SE CONNECTER -->
            <LinearLayout
                android:id="@+id/buttonSeConnecter"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@drawable/shape_button_outline"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Se connecter"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</FrameLayout>