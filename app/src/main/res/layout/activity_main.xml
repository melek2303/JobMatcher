<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- ── MAIN SCROLL CONTENT ── -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingTop="24dp"
            android:paddingBottom="100dp">

            <!-- Header row: greeting + CV button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_base" />

                    <TextView
                        android:id="@+id/tvTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/offers_title"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_3xl"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/tvOfferCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5 offres disponibles"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_sm"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Import CV Button -->
                <Button
                    android:id="@+id/btnImportCv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_import_cv"
                    android:background="@drawable/bg_btn_primary"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_sm"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:drawableStart="@android:drawable/ic_menu_upload"
                    android:drawablePadding="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:stateListAnimator="@null" />
            </LinearLayout>

            <!-- ── SEARCH BAR ── -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="12dp">

                <EditText
                    android:id="@+id/etSearch"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_search_bar"
                    android:hint="@string/search_hint"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_sm"
                    android:paddingStart="44dp"
                    android:paddingEnd="16dp"
                    android:inputType="text"
                    android:singleLine="true"
                    android:imeOptions="actionSearch"
                    android:maxLines="1" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="13dp"
                    android:src="@android:drawable/ic_menu_search"
                    android:contentDescription="Rechercher"
                    app:tint="@color/text_muted" />
            </FrameLayout>

            <!-- ── FILTER CHIPS ROW ── -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Location filter chip -->
                    <TextView
                        android:id="@+id/chipLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Localisation"
                        android:background="@drawable/bg_filter_chip"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_sm"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:gravity="center"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Category filter chip -->
                    <TextView
                        android:id="@+id/chipCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Catégorie"
                        android:background="@drawable/bg_filter_chip"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_sm"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:gravity="center"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Contract type chip -->
                    <TextView
                        android:id="@+id/chipContract"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Type"
                        android:background="@drawable/bg_filter_chip"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_sm"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- ── JOB LIST (RecyclerView) ── -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvJobOffers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false" />

            <!-- Empty state -->
            <TextView
                android:id="@+id/tvEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_results"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_base"
                android:gravity="center"
                android:paddingTop="40dp"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ── BOTTOM NAVIGATION BAR ── -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/bg_card"
        app:itemIconTint="@color/selector_nav_item"
        app:itemTextColor="@color/selector_nav_item"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled"
        app:elevation="8dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
